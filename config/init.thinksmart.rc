import /vendor/etc/init/hw/init.mainline.qcom.rc

# Feed every 10 seconds; the second argument is a 20-second timeout margin.
service watchdogd /system/bin/watchdogd 10 20
    class core
    user root
    group root
    seclabel u:r:watchdogd:s0
    shutdown critical

on early-init
    exec_start vendor.timekeep-initialize

on init
    write /sys/block/zram0/comp_algorithm lz4

on property:persist.sys.zram_enabled=1
    swapon_all /vendor/etc/fstab.thinksmart

on fs
    mount_all /vendor/etc/fstab.thinksmart --early

on late-fs
    mount_all /vendor/etc/fstab.thinksmart --late

on post-fs-data
    # modules.load probes VCNL4200 before BMA253 to retain iio:device0.
    # Lenovo DSP profile: 75 mA setting, two pulses, 8T (driver ABI encoding).
    wait /sys/devices/platform/i2c-sensors/i2c-0/0-0051/iio:device0/in_proximity_integration_time 10
    write /sys/devices/platform/i2c-sensors/i2c-0/0-0051/iio:device0/in_proximity_calibbias 0.075000
    write /sys/devices/platform/i2c-sensors/i2c-0/0-0051/iio:device0/in_proximity_oversampling_ratio 2
    write /sys/devices/platform/i2c-sensors/i2c-0/0-0051/iio:device0/in_proximity_integration_time 0.000768

# Adreno 506: use Mesa GMEM tiling instead of the qcom-common "sysmem" quirk.
# Measured on CD-18781Y (2026-11-15): launcher jank 48% -> 16%, Settings p50 19 -> 12 ms, no visible artifacts.
on property:init.svc.vendor.msm_drm_quirks=stopped
    setprop vendor.mesa.fd.mesa.debug ""

# Mains-powered panel: no CPU power collapse, only WFI. Waking from power collapse costs up to
# 270 us and cold caches; measured -8% cold app start, -20% median frame time, same temperature.
on boot
    write /sys/devices/system/cpu/cpu0/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu1/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu2/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu3/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu4/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu5/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu6/cpuidle/state1/disable 1
    write /sys/devices/system/cpu/cpu7/cpuidle/state1/disable 1
