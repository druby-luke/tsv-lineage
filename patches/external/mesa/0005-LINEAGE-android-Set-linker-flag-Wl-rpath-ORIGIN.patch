From 10cd3ad4f94289c8564bf706c335ab1400ff6e45 Mon Sep 17 00:00:00 2001
From: Yumi Yukimura <me.cafebabe@gmail.com>
Date: Wed, 2 Sep 2026 02:20:12 +0800
Subject: [PATCH 05/19] LINEAGE: android: Set linker flag `-Wl,-rpath,$ORIGIN`

This allows program inside an APEX to open the chain
`dri_gbm.so -> libgallium_dri.so` in `/vendor/lib64`.

Assisted-by: OpenCode/GPT-5.6 Sol
Change-Id: I791f6104dbcaab8140a12fce4c18289110891fca

Base-commit: b69adc2adfbfe3eb985bd66cd06c61ca719ae9ae
Apply in filename order within this project.
Source: https://github.com/LineageOS/android_external_mesa/commit/10cd3ad4f94289c8564bf706c335ab1400ff6e45
Backport: retain the existing Lineage Android integration on Mesa 26.2.7.

---
 android/mesa3d_cross.mk |    1 +
 1 file changed, 1 insertion(+)

diff --git a/android/mesa3d_cross.mk b/android/mesa3d_cross.mk
index 85810cc25ae2fca521eba5fa39708f3be095e066..97eebe88ca02b050598860416560059902de2839 100644
--- a/android/mesa3d_cross.mk
+++ b/android/mesa3d_cross.mk
@@ -158,6 +158,7 @@ $(MESON_GEN_FILES_TARGET): PRIVATE_TARGET_CRTEND_SO_O := $(my_target_crtend_so_o
 define m-lld-flags
   -Wl,-e,main \
   -nostdlib -Wl,--gc-sections \
+  -Wl,-rpath,\$$ORIGIN \
   $(PRIVATE_TARGET_CRTBEGIN_SO_O) \
   $(PRIVATE_ALL_OBJECTS) \
   -Wl,--whole-archive \
