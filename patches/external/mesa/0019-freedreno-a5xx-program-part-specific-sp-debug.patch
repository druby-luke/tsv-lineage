From e9b12c2774a7075cd5624ea44bc4aa5564cb7f5f Mon Sep 17 00:00:00 2001
From: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>
Date: Mon, 5 Oct 2026 10:39:42 +0300
Subject: [PATCH 19/19] freedreno/a5xx: write the part's SP_DBG_ECO_CNTL

SP_DBG_ECO_CNTL is written with the a530's value on every GPU except the
a540, but bit 30 should be set only on the a510 and a530.

Set it only on those two, which also covers the a540.

Fixes: 07e1233c6157 ("freedreno: Enable Adreno 508, 509 and 512")
Fixes: dc6f7045665e ("freedreno: Enable A506")
Fixes: afb7b17fddca ("freedreno: Enable A505")
Assisted-by: LLM
Signed-off-by: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>
Part-of: <https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/45481>

Base-commit: b69adc2adfbfe3eb985bd66cd06c61ca719ae9ae
Apply in filename order within this project.
Upstream-commit: e9b12c2774a7075cd5624ea44bc4aa5564cb7f5f
Source: https://gitlab.freedesktop.org/mesa/mesa/-/commit/e9b12c2774a7075cd5624ea44bc4aa5564cb7f5f
Backport: omit the newer computerator tool, which is absent from Mesa 26.2.7; retain the runtime changes and decoder reference updates.
Backport: refresh context to preserve this branch's existing SP_MODE_CNTL value of 0x1e; change only the part-specific SP_DBG_ECO_CNTL programming.

---
 src/gallium/drivers/freedreno/a5xx/fd5_emit.c |   21 +++++++++++++++------
 1 file changed, 15 insertions(+), 6 deletions(-)

diff --git a/src/gallium/drivers/freedreno/a5xx/fd5_emit.c b/src/gallium/drivers/freedreno/a5xx/fd5_emit.c
index f3680d476488cf1ac2425048aecd02b9602b02ef..52cb2279dcabce547d42678f96fb0e284a315de7 100644
--- a/src/gallium/drivers/freedreno/a5xx/fd5_emit.c
+++ b/src/gallium/drivers/freedreno/a5xx/fd5_emit.c
@@ -903,6 +903,18 @@ fd5_emit_cs_state(struct fd_context *ctx, struct fd_ringbuffer *ring,
       fd5_emit_images(ctx, ring, MESA_SHADER_COMPUTE, cp);
 }
 
+static uint32_t
+fd5_sp_dbg_eco_cntl(const struct fd_screen *screen)
+{
+   switch (screen->gpu_id) {
+   case 510:
+   case 530:
+      return 0x40000800;
+   default:
+      return 0x00000800;
+   }
+}
+
 /* Workaround bits the kernel sets in hw_init, which the restore rewrites */
 static bool
 fd5_rb_dp2_clock_gating_disabled(const struct fd_screen *screen)
@@ -1003,15 +1015,12 @@ fd5_emit_restore(struct fd_batch *batch, struct fd_ringbuffer *ring)
    OUT_PKT4(ring, REG_A5XX_SP_MODE_CNTL, 1);
    OUT_RING(ring, 0x0000001e); /* SP_MODE_CNTL */
 
-   if (ctx->screen->gpu_id == 540) {
-      OUT_PKT4(ring, REG_A5XX_SP_DBG_ECO_CNTL, 1);
-      OUT_RING(ring, 0x800); /* SP_DBG_ECO_CNTL */
+   OUT_PKT4(ring, REG_A5XX_SP_DBG_ECO_CNTL, 1);
+   OUT_RING(ring, fd5_sp_dbg_eco_cntl(ctx->screen));
 
+   if (ctx->screen->gpu_id == 540) {
       OUT_PKT4(ring, REG_A5XX_HLSQ_DBG_ECO_CNTL, 1);
       OUT_RING(ring, 0x0);
-   } else {
-      OUT_PKT4(ring, REG_A5XX_SP_DBG_ECO_CNTL, 1);
-      OUT_RING(ring, 0x40000800); /* SP_DBG_ECO_CNTL */
    }
 
    OUT_PKT4(ring, REG_A5XX_TPL1_MODE_CNTL, 1);
-- 
