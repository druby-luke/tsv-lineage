diff --git a/src/freedreno/registers/adreno/a5xx.xml b/src/freedreno/registers/adreno/a5xx.xml
index a275460fab7ac11a47c7161cadc34ecd299b1711..f78363643f365e538d9539ab89de16795ac73ff9 100644
