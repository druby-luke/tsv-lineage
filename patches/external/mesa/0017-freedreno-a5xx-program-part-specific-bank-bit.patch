 			UNKNOWN_E293: 0
 00000005001900b0:		0000: 40e29202 00000000 00000000
 		write RB_MODE_CNTL (0cc6)
-			RB_MODE_CNTL: 0x44
+			RB_MODE_CNTL: { HIGHESTBANKBIT = 2 | 0x40 }
 00000005001900bc:		0000: 480cc601 00000044
 		write RB_DBG_ECO_CNTL (0cc4)
 			RB_DBG_ECO_CNTL: 0x100000
@@ -239,7 +239,7 @@ cmdstream[0]: 207 dwords
 			SP_DBG_ECO_CNTL: 0x800
 00000005001900e4:		0000: 400ec001 00000800
 		write TPL1_MODE_CNTL (0f02)
-			TPL1_MODE_CNTL: 0x544
+			TPL1_MODE_CNTL: { HIGHESTBANKBIT = 2 | 0x444 }
 00000005001900ec:		0000: 400f0201 00000544
 		write HLSQ_TIMEOUT_THRESHOLD_0 (0e00)
 			HLSQ_TIMEOUT_THRESHOLD_0: 0x80
@@ -709,7 +709,7 @@ cmdstream[0]: 207 dwords
 			draw[0] register values
 !+	00000001			CP_SCRATCH[0].REG: 1
 !+	00100000			RB_DBG_ECO_CNTL: 0x100000
-!+	00000044			RB_MODE_CNTL: 0x44
+!+	00000044			RB_MODE_CNTL: { HIGHESTBANKBIT = 2 | 0x40 }
 !+	10000000			RB_CCU_CNTL: 0x10000000
 !+	0000001f			PC_MODE_CNTL: 0x1f
  +	00000000			PC_TESSFACTOR_ADDR: 0
@@ -724,7 +724,7 @@ cmdstream[0]: 207 dwords
 !+	00000012			UCHE_CACHE_INVALIDATE: 0x12
 !+	00000800			SP_DBG_ECO_CNTL: 0x800
 !+	0000001e			SP_MODE_CNTL: 0x1e
-!+	00000544			TPL1_MODE_CNTL: 0x544
+!+	00000544			TPL1_MODE_CNTL: { HIGHESTBANKBIT = 2 | 0x444 }
 !+	3ff00010			GRAS_SU_POINT_MINMAX: { MIN = 1.000000 | MAX = 1023.000000 }
 !+	00000008			GRAS_SU_POINT_SIZE: 0.500000
  +	00000000			GRAS_SU_CONSERVATIVE_RAS_CNTL: 0
diff --git a/src/gallium/drivers/freedreno/a5xx/fd5_blitter.c b/src/gallium/drivers/freedreno/a5xx/fd5_blitter.c
index 0a8b2fc7b57634b9f624776ac6c1ce793b8d4082..e3fcfc25b874ccb68715c74888a1f14ae6977a7f 100644
--- a/src/gallium/drivers/freedreno/a5xx/fd5_blitter.c
+++ b/src/gallium/drivers/freedreno/a5xx/fd5_blitter.c
@@ -243,12 +243,14 @@ can_do_blit(const struct pipe_blit_info *info)
 }
 
 static void
-emit_setup(struct fd_ringbuffer *ring, enum pipe_format dst_format)
+emit_setup(struct fd_ringbuffer *ring, const struct fd_screen *screen,
+           enum pipe_format dst_format)
 {
    enum a5xx_color_fmt dfmt = fd5_pipe2color(dst_format);
    uint32_t blit_cntl = A5XX_RB_2D_BLIT_CNTL_ROP(ROP_COPY) |
                         A5XX_RB_2D_BLIT_CNTL_IFMT(fd5_ifmt(dfmt)) |
                         A5XX_RB_2D_BLIT_CNTL_UNK31;
+   uint32_t hbb = screen->highest_bank_bit - 13;
 
    OUT_PKT4(ring, REG_A5XX_RB_RENDER_CNTL, 1);
    OUT_RING(ring, 0x00000008);
@@ -266,13 +268,13 @@ emit_setup(struct fd_ringbuffer *ring, enum pipe_format dst_format)
    OUT_RING(ring, A5XX_RB_CNTL_BYPASS);
 
    OUT_PKT4(ring, REG_A5XX_RB_MODE_CNTL, 1);
-   OUT_RING(ring, 0x00000004); /* RB_MODE_CNTL */
+   OUT_RING(ring, A5XX_RB_MODE_CNTL_HIGHESTBANKBIT(hbb));
 
    OUT_PKT4(ring, REG_A5XX_SP_MODE_CNTL, 1);
    OUT_RING(ring, 0x0000000c); /* SP_MODE_CNTL */
 
    OUT_PKT4(ring, REG_A5XX_TPL1_MODE_CNTL, 1);
-   OUT_RING(ring, 0x00000344); /* TPL1_MODE_CNTL */
+   OUT_RING(ring, 0x00000244 | A5XX_TPL1_MODE_CNTL_HIGHESTBANKBIT(hbb));
 
    OUT_PKT4(ring, REG_A5XX_HLSQ_MODE_CNTL, 1);
    OUT_RING(ring, 0x00000002); /* HLSQ_MODE_CNTL */
@@ -604,7 +606,7 @@ fd5_blitter_blit(struct fd_context *ctx,
 
    fd_batch_update_queries(batch);
 
-   emit_setup(batch->draw, info->dst.format);
+   emit_setup(batch->draw, batch->ctx->screen, info->dst.format);
 
    if ((info->src.resource->target == PIPE_BUFFER) &&
        (info->dst.resource->target == PIPE_BUFFER)) {
