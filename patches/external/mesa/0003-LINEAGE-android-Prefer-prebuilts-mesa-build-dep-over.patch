From 8dd3accabb331fefa6fb3371056f1fdd705b1f47 Mon Sep 17 00:00:00 2001
From: Yumi Yukimura <me.cafebabe@gmail.com>
Date: Sat, 27 Sep 2025 14:45:32 +0800
Subject: [PATCH 03/19] LINEAGE: android: Prefer prebuilts/mesa-build-dep over
 /usr/bin/

Change-Id: I4e58093f5d350cdaad885863dbb676e58c80b54c

Base-commit: b69adc2adfbfe3eb985bd66cd06c61ca719ae9ae
Apply in filename order within this project.
Source: https://github.com/LineageOS/android_external_mesa/commit/8dd3accabb331fefa6fb3371056f1fdd705b1f47
Backport: retain the existing Lineage Android integration on Mesa 26.2.7.

---
 android/mesa3d_cross.mk |    4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/android/mesa3d_cross.mk b/android/mesa3d_cross.mk
index 63367b04f14757339403323cb67083a7d1d631d3..85810cc25ae2fca521eba5fa39708f3be095e066 100644
--- a/android/mesa3d_cross.mk
+++ b/android/mesa3d_cross.mk
@@ -83,7 +83,7 @@ MESA3D_GLES_BINS := \
     $($(M_TARGET_PREFIX)MESA3D_LIBGLESV2_BIN) \
 
 MESON_GEN_NINJA := \
-	cd $(MESON_OUT_DIR) && PATH=/usr/bin:/usr/local/bin:$(AOSP_ABSOLUTE_PATH)/prebuilts/mesa-build-dep/bin:$$PATH meson ./build \
+	cd $(MESON_OUT_DIR) && PATH=$(AOSP_ABSOLUTE_PATH)/prebuilts/mesa-build-dep/bin:/usr/bin:/usr/local/bin:$$PATH meson ./build \
 	--cross-file $(call relative-to-absolute,$(MESON_GEN_DIR))/aosp_cross        \
 	--buildtype=release                                                          \
 	-Dplatforms=android                                                          \
@@ -100,7 +100,7 @@ MESON_GEN_NINJA := \
 	-Dandroid-libbacktrace=disabled                                              \
 	$(BOARD_MESA3D_MESON_ARGS)                                                   \
 
-MESON_BUILD := PATH=/usr/bin:/bin:/sbin:$(AOSP_ABSOLUTE_PATH)/prebuilts/mesa-build-dep/bin:$$PATH ninja -C $(MESON_OUT_DIR)/build
+MESON_BUILD := PATH=$(AOSP_ABSOLUTE_PATH)/prebuilts/mesa-build-dep/bin:/usr/bin:/bin:/sbin:$$PATH ninja -C $(MESON_OUT_DIR)/build
 
 $(MESON_GEN_FILES_TARGET): MESON_CPU_FAMILY := $(subst arm64,aarch64,$(TARGET_$(M_TARGET_PREFIX)ARCH))
 
-- 
