From 1199ef90e77fae5ccd6264850f9fb1d55d5cdfab Mon Sep 17 00:00:00 2001
From: Yumi Yukimura <me.cafebabe@gmail.com>
Date: Mon, 13 Jan 2025 02:29:57 +0800
Subject: [PATCH 08/19] LINEAGE: android: Include libdrm_intel for i915 too

Fixes:
meson.build:1669:6: ERROR: Dependency "libdrm_intel" not found, tried pkgconfig

Change-Id: I79b750f0203235932767be986fb7b3e952138808

Base-commit: b69adc2adfbfe3eb985bd66cd06c61ca719ae9ae
Apply in filename order within this project.
Source: https://github.com/LineageOS/android_external_mesa/commit/1199ef90e77fae5ccd6264850f9fb1d55d5cdfab
Backport: retain the existing Lineage Android integration on Mesa 26.2.7.

---
 android/Android.mk |    2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/android/Android.mk b/android/Android.mk
index b42878f252abe72888ddedb6077dddf0115c83b2..bc82d1a280e4228fa647b1fb2404a09c75a0141e 100644
--- a/android/Android.mk
+++ b/android/Android.mk
@@ -75,7 +75,7 @@ LOCAL_SHARED_LIBRARIES += libvulkan
 MESON_GEN_PKGCONFIGS += vulkan
 endif
 
-ifneq ($(filter i915,$(BOARD_MESA3D_GALLIUM_DRIVERS)),)
+ifneq ($(filter i915 iris,$(BOARD_MESA3D_GALLIUM_DRIVERS)),)
 LOCAL_SHARED_LIBRARIES += libdrm_intel
 MESON_GEN_PKGCONFIGS += libdrm_intel:$(LIBDRM_VERSION)
 endif
