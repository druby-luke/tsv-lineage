+++ b/src/freedreno/registers/adreno/adreno_common.xml
@@ -451,4 +451,26 @@ xsi:schemaLocation="https://gitlab.freedesktop.org/freedreno/ rules-fd.xsd">
 	 -->
 </domain>
 
+<!-- The 2D blit core converts through an intermediate format.
+     Shared by a5xx ({RB,GRAS}_2D_BLIT_CNTL) and a6xx (A2D_BLT_CNTL). -->
+<enum name="adreno_2d_ifmt">
+	<value value="0x7"  name="R2D_INT32"/>
+	<value value="0x6"  name="R2D_INT16"/>
+	<value value="0x5"  name="R2D_INT8"/>
+	<value value="0x4"  name="R2D_FLOAT32"/>
+	<value value="0x3"  name="R2D_FLOAT16"/>
+	<value value="0x2"  name="R2D_SNORM8"/>
+	<value value="0x1"  name="R2D_UNORM8_SRGB"/>
+	<value value="0x0"  name="R2D_UNORM8"/>
+
+	<!-- Not a hw enum, used internally in driver -->
+	<value value="0xff" name="R2D_NONE"/>
+</enum>
+
+<enum name="adreno_2d_output_ifmt_type">
+	<value name="OUTPUT_IFMT_2D_FLOAT" value="0"/>
+	<value name="OUTPUT_IFMT_2D_SINT" value="1"/>
+	<value name="OUTPUT_IFMT_2D_UINT" value="2"/>
+</enum>
+
 </database>
