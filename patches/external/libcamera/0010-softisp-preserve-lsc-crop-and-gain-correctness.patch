+/**
+ * \brief Sample a full-reference, uniformly spaced table for a sensor crop
+ * \param[in] cropRectangle Crop relative to the reference sensor area
+ * \param[in] xPos Normalized horizontal positions of the destination nodes
+ * \param[in] yPos Normalized vertical positions of the destination nodes
+ * \return Resampled components, or an empty map for invalid geometry
+ */
+LscImplementation::ComponentsMap
+LscTable::sampleForCrop(const Rectangle &cropRectangle,
+		       std::span<const double> xPos, std::span<const double> yPos)
+{
+	if (!resample_)
+		return lscData_;
+
+	auto validPositions = [](std::span<const double> positions) {
+		return !positions.empty() &&
+		       std::all_of(positions.begin(), positions.end(), [](double position) {
+			       return std::isfinite(position) && position >= 0.0 && position <= 1.0;
+		       });
+	};
+	if (cropRectangle.isNull() ||
+	    cropRectangle.boundedTo(Rectangle(sensorSize_)) != cropRectangle ||
+	    !validPositions(xPos) || !validPositions(yPos)) {
+		LOG(LscTable, Error) << "Invalid LSC crop or sampling positions";
+		return {};
+	}
+
+	ComponentsMap result;
+	for (const auto &[temperature, components] : lscData_) {
+		for (const auto &[channel, table] : components) {
+			auto &samples = result[temperature][channel];
+			samples.reserve(xPos.size() * yPos.size());
+			for (double y : yPos) {
+				const double sourceY =
+					(cropRectangle.y + y * (cropRectangle.height - 1)) *
+					(gridSize_.height - 1) / (sensorSize_.height - 1);
+				const unsigned int top = std::floor(sourceY);
+				const unsigned int bottom = std::min(top + 1, gridSize_.height - 1);
+				const double fy = sourceY - top;
+				for (double x : xPos) {
+					const double sourceX =
+						(cropRectangle.x + x * (cropRectangle.width - 1)) *
+						(gridSize_.width - 1) / (sensorSize_.width - 1);
+					const unsigned int left = std::floor(sourceX);
+					const unsigned int right = std::min(left + 1, gridSize_.width - 1);
+					const double fx = sourceX - left;
+					auto at = [&](unsigned int column, unsigned int row) {
+						return table[row * gridSize_.width + column];
+					};
+					const double upper = at(left, top) * (1.0 - fx) + at(right, top) * fx;
+					const double lower = at(left, bottom) * (1.0 - fx) + at(right, bottom) * fx;
+					samples.push_back(upper * (1.0 - fy) + lower * fy);
+				}
+			}
+		}
+	}
+	return result;
 }
 
