diff --git a/test/ipa/libipa/lsc.cpp b/test/ipa/libipa/lsc.cpp
new file mode 100644
--- /dev/null
+++ b/test/ipa/libipa/lsc.cpp
@@ -0,0 +1,166 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "lsc_table.h"
+
+#include <array>
+#include <cmath>
+#include <iostream>
+#include <memory>
+#include <sys/mman.h>
+
+#include <libcamera/camera_manager.h>
+#include <libcamera/formats.h>
+#include <libcamera/stream.h>
+
+#include "libcamera/internal/software_isp/lsc_stats.h"
+#include "libcamera/internal/software_isp/swstats_cpu.h"
+
+#include "test.h"
+
+using namespace libcamera;
+
+class LscTest : public Test
+{
+	int checkCrops()
+	{
+		ValueNode sets;
+		auto set = std::make_unique<ValueNode>();
+		set->add("ct", std::make_unique<ValueNode>(std::string("6500")));
+		auto values = std::make_unique<ValueNode>();
+		for (unsigned int y = 0; y < 17; y++)
+			for (unsigned int x = 0; x < 17; x++)
+				values->add(std::make_unique<ValueNode>(
+					std::to_string(32 + 2 * x + 3 * y)));
+		set->add("r", std::move(values));
+		sets.add(std::move(set));
+
+		ipa::LscTable table;
+		if (table.parseLscData(sets, { .keys = { "r" },
+					      .numHSamples = 17, .numVSamples = 17,
+					      .sensorSize = { 2608, 1960 },
+					      .resampleTable = true }))
+			return TestFail;
+
+		const std::array<double, 4> positions{ 0.0, 0.125, 0.5, 1.0 };
+		const std::array<Rectangle, 3> crops{
+			Rectangle(0, 0, 2608, 1960),
+			Rectangle(336, 432, 1936, 1096),
+			Rectangle(8, 244, 2592, 1472),
+		};
+		for (const Rectangle &crop : crops) {
+			auto result = table.sampleForCrop(crop, positions, positions);
+			if (result.empty() || result.at(6500).at("r").size() != 16)
+				return TestFail;
+			const auto &gains = result.at(6500).at("r");
+			for (unsigned int y = 0; y < positions.size(); y++) {
+				for (unsigned int x = 0; x < positions.size(); x++) {
+					const double nx = (crop.x + positions[x] * (crop.width - 1)) / 2607.0;
+					const double ny = (crop.y + positions[y] * (crop.height - 1)) / 1959.0;
+					const double expected = 32 + 32 * nx + 48 * ny;
+					if (std::abs(gains[y * positions.size() + x] - expected) > 0.0001) {
+						std::cerr << "Incorrect LSC crop/orientation for " << crop << std::endl;
+						return TestFail;
+					}
+				}
+			}
+		}
+		for (const Rectangle &invalid : {
+			     Rectangle(0, 0, 2609, 1960),
+			     Rectangle(-1, 0, 2608, 1960),
+			     Rectangle(2607, 0, 2, 1960),
+		     }) {
+			if (!table.sampleForCrop(invalid, positions, positions).empty())
+				return TestFail;
+		}
+		return TestPass;
+	}
+
+	int checkSampling()
+	{
+		DebayerParams::LscLookupTable lut{};
+		for (unsigned int y = 0; y < 17; y++)
+			for (unsigned int x = 0; x < 17; x++)
+				lut[(y * 17 + x) * 4] = 32 + 2 * x + 3 * y;
+
+		for (double y : { 0.0, 0.03125, 0.35, 1.0 })
+			for (double x : { 0.0, 0.03125, 0.65, 1.0 }) {
+				const auto expected = std::lround((1 + x + 1.5 * y) * 1024);
+				if (sampleLscStatsGain(lut, x, y, 0, 255.0f / 32) != expected)
+					return TestFail;
+			}
+
+		lut.fill(59);
+		if (sampleLscStatsGain(lut, 0.5, 0.5, 0, 255.0f / 59) != 1024 ||
+		    applyLscStatsGain(64, 2048, 64, 1023) != 64 ||
+		    applyLscStatsGain(0, 2048, 64, 1023) != 64 ||
+		    applyLscStatsGain(400, 2048, 64, 1023) != 736 ||
+		    applyLscStatsGain(900, 2048, 64, 1023) != 1023)
+			return TestFail;
+		return TestPass;
+	}
+
+	int checkStatistics()
+	{
+		CameraManager manager;
+		SwStatsCpu stats(manager);
+		if (!stats.isValid())
+			return TestFail;
+		StreamConfiguration config;
+		config.pixelFormat = formats::SGRBG10;
+		config.size = { 64, 16 };
+		config.stride = 256;
+		if (stats.configure(config))
+			return TestFail;
+		stats.setWindow({ 8, 2, 16, 8 });
+
+		DebayerParams params{};
+		params.lscLut.fill(32);
+		params.lscLutVersion = 1;
+		params.lscGainScale = 255.0f / 32;
+		params.blackLevel = RGB<double>(16.0f / 255);
+		std::array<uint16_t, 128> raw;
+		raw.fill(400);
+		const uint8_t *line = reinterpret_cast<const uint8_t *>(raw.data());
+		const uint8_t *lines[] = { line, line, line };
+
+		auto capture = [&](bool enabled, bool available, float scale, unsigned int expected) {
+			params.lscEnabled = enabled;
+			params.lscGainScale = scale;
+			stats.setDebayerParams(params, available);
+			stats.startFrame(0);
+			for (unsigned int y = 0; y < 16; y += 4)
+				stats.processLine0(0, y, lines);
+			stats.finishFrame(0, 0);
+
+			void *address = mmap(nullptr, sizeof(SwIspStats), PROT_READ, MAP_SHARED,
+					     stats.getStatsFD().get(), 0);
+			if (address == MAP_FAILED)
+				return false;
+			const SwIspStats result = *static_cast<const SwIspStats *>(address);
+			munmap(address, sizeof(SwIspStats));
+			return result.valid && result.numPixels_ &&
+			       result.sum_.r() == result.numPixels_ * expected &&
+			       result.sum_.g() == result.numPixels_ * expected &&
+			       result.sum_.b() == result.numPixels_ * expected;
+		};
+		/* Same LUT version, different scale must rebuild the cached gains. */
+		if (!capture(true, true, 255.0f / 32, 100) ||
+		    !capture(true, true, 255.0f / 64, 58) ||
+		    !capture(false, true, 255.0f / 32, 100) ||
+		    !capture(true, false, 255.0f / 32, 100))
+			return TestFail;
+		return TestPass;
+	}
+
+protected:
+	int run() override
+	{
+		if (checkCrops() || checkSampling() || checkStatistics()) {
+			std::cerr << "Lens shading regression failed" << std::endl;
+			return TestFail;
+		}
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(LscTest)
