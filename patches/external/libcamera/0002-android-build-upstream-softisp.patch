+#!/usr/bin/env python3
+# SPDX-License-Identifier: CC0-1.0
+"""Run source-tree generators with Soong's bundled Python dependencies."""
+
+import os
+import runpy
+import sys
+
+script = sys.argv[1]
+sys.argv = sys.argv[1:]
+sys.path.insert(0, os.path.dirname(os.path.abspath(script)))
+runpy.run_path(script, run_name="__main__")
