diff --git a/test/software_isp/debayer_egl.cpp b/test/software_isp/debayer_egl.cpp
new file mode 100644
--- /dev/null
+++ b/test/software_isp/debayer_egl.cpp
@@ -0,0 +1,186 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <algorithm>
+#include <fcntl.h>
+#include <functional>
+#include <iostream>
+#include <memory>
+#include <string>
+#include <sys/mman.h>
+#include <vector>
+
+#include <libcamera/camera_manager.h>
+#include <libcamera/formats.h>
+#include <libcamera/stream.h>
+
+#include <libcamera/base/memfd.h>
+
+#include "libcamera/internal/dma_buf_allocator.h"
+#include "libcamera/internal/framebuffer.h"
+
+#include "software_isp/debayer_egl.h"
+
+#include "test.h"
+
+using namespace libcamera;
+
+class DebayerEGLTest : public Test
+{
+	int run() override
+	{
+		EGLDisplay display = eGL::probeDisplay();
+		if (display == EGL_NO_DISPLAY) {
+			std::cerr << "No EGL display available" << std::endl;
+			return TestSkip;
+		}
+
+		auto stats = std::make_unique<SwStatsCpu>(cm_);
+		if (!stats->isValid())
+			return TestFail;
+		stats->statsReady.connect(this, &DebayerEGLTest::statsReady);
+		void *statsMapping = mmap(nullptr, sizeof(SwIspStats), PROT_READ,
+					  MAP_SHARED, stats->getStatsFD().get(), 0);
+		if (statsMapping == MAP_FAILED) {
+			std::cerr << "Failed to map statistics" << std::endl;
+			return TestFail;
+		}
+		stats_ = static_cast<const SwIspStats *>(statsMapping);
+
+		debayer_ = std::make_unique<DebayerEGL>(std::move(stats), cm_, display);
+		debayer_->inputBufferReady.connect(this, &DebayerEGLTest::inputReady);
+		debayer_->outputBufferReady.connect(this, &DebayerEGLTest::outputReady);
+
+		StreamConfiguration inputCfg;
+		inputCfg.pixelFormat = formats::SBGGR8;
+		inputCfg.size = { 16, 16 };
+		inputCfg.stride = 16;
+		inputCfg.bufferCount = 2;
+		StreamConfiguration outputCfg;
+		outputCfg.pixelFormat = formats::XRGB8888;
+		outputCfg.size = debayer_->sizes(inputCfg.pixelFormat, inputCfg.size).max;
+		std::tie(outputCfg.stride, outputCfg.frameSize) =
+			debayer_->strideAndFrameSize(outputCfg.pixelFormat, outputCfg.size);
+		outputCfg.bufferCount = 2;
+		if (debayer_->configure(inputCfg, { std::cref(outputCfg) }, false, false) ||
+		    debayer_->start())
+			return TestFail;
+		started_ = true;
+
+		DmaBufAllocator allocator(DmaBufAllocator::DmaBufAllocatorFlag::SystemHeap |
+					  DmaBufAllocator::DmaBufAllocatorFlag::UDmaBuf);
+		if (!allocator.isValid()) {
+			std::cerr << "No DMA buffer allocator available" << std::endl;
+			return TestSkip;
+		}
+		std::vector<std::unique_ptr<FrameBuffer>> inputs, outputs;
+		if (allocator.exportBuffers(1, { 256 }, &inputs) != 1 ||
+		    allocator.exportBuffers(1, { outputCfg.frameSize }, &outputs) != 1)
+			return TestFail;
+
+		{
+			DmaSyncer sync(inputs[0]->planes()[0].fd, DmaSyncer::SyncType::Write);
+			MappedFrameBuffer mapping(inputs[0].get(), MappedFrameBuffer::MapFlag::Write);
+			if (!mapping.isValid())
+				return TestFail;
+			std::fill(mapping.planes()[0].begin(), mapping.planes()[0].end(), 128);
+		}
+
+		UniqueFD backing = MemFd::create("unreadable-frame", 256);
+		if (!backing.isValid())
+			return TestFail;
+		const std::string path = "/proc/self/fd/" + std::to_string(backing.get());
+		SharedFD invalidFd{ UniqueFD(open(path.c_str(), O_WRONLY | O_CLOEXEC)) };
+		if (!invalidFd.isValid())
+			return TestFail;
+		const std::vector<FrameBuffer::Plane> invalidPlanes{
+			{ .fd = invalidFd, .offset = 0, .length = 256 },
+		};
+		FrameBuffer invalid(invalidPlanes);
+		FrameBuffer *input = inputs[0].get();
+		FrameBuffer *output = outputs[0].get();
+
+		if (checkFrame(0, input, output, false) ||
+		    checkFrame(4, &invalid, output, true) ||
+		    checkFrame(8, input, output, false) ||
+		    checkFrame(9, input, &invalid, true) ||
+		    checkFrame(12, input, output, false))
+			return TestFail;
+
+		/* Fail after GPU work has been submitted, not only during import. */
+		glEnable(0xffffffff);
+		if (checkFrame(16, input, output, true) ||
+		    checkFrame(20, input, output, false))
+			return TestFail;
+
+		return TestPass;
+	}
+
+	int checkFrame(uint32_t frame, FrameBuffer *input, FrameBuffer *output, bool failed)
+	{
+		inputCount_ = outputCount_ = statsCount_ = 0;
+		input_ = output_ = nullptr;
+		auto &inputMetadata = input->_d()->metadata();
+		inputMetadata.status = FrameMetadata::FrameSuccess;
+		inputMetadata.sequence = frame;
+		inputMetadata.timestamp = 1000000ULL * (frame + 1);
+		auto &outputMetadata = output->_d()->metadata();
+		outputMetadata.status = FrameMetadata::FrameSuccess;
+		outputMetadata.planes()[0].bytesused = 123;
+
+		debayer_->process(frame, input, output, {});
+		const bool validStats = !failed && frame % SwStatsCpu::kStatPerNumFrames == 0;
+		const FrameMetadata::Status expectedStatus = failed ?
+			FrameMetadata::FrameError : FrameMetadata::FrameSuccess;
+		if (inputCount_ != 1 || outputCount_ != 1 || statsCount_ != 1 ||
+		    input_ != input || output_ != output || statsFrame_ != frame ||
+		    stats_->valid != validStats || outputMetadata.status != expectedStatus ||
+		    outputMetadata.sequence != frame ||
+		    outputMetadata.timestamp != inputMetadata.timestamp ||
+		    outputMetadata.planes()[0].bytesused !=
+			    (failed ? 0 : output->planes()[0].length)) {
+			std::cerr << "Incorrect frame completion for frame " << frame << std::endl;
+			return TestFail;
+		}
+		return TestPass;
+	}
+
+	void inputReady(FrameBuffer *input)
+	{
+		input_ = input;
+		inputCount_++;
+	}
+
+	void outputReady(FrameBuffer *output)
+	{
+		output_ = output;
+		outputCount_++;
+	}
+
+	void statsReady(uint32_t frame, [[maybe_unused]] uint32_t bufferId)
+	{
+		statsFrame_ = frame;
+		statsCount_++;
+	}
+
+	void cleanup() override
+	{
+		if (started_)
+			debayer_->stop();
+		debayer_.reset();
+		if (stats_)
+			munmap(const_cast<SwIspStats *>(stats_), sizeof(SwIspStats));
+	}
+
+	CameraManager cm_;
+	std::unique_ptr<DebayerEGL> debayer_;
+	bool started_ = false;
+	const SwIspStats *stats_ = nullptr;
+	FrameBuffer *input_ = nullptr;
+	FrameBuffer *output_ = nullptr;
+	unsigned int inputCount_ = 0;
+	unsigned int outputCount_ = 0;
+	unsigned int statsCount_ = 0;
+	uint32_t statsFrame_ = 0;
+};
+
+TEST_REGISTER(DebayerEGLTest)
