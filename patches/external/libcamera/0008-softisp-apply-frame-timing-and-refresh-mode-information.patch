 	delayedCtrls_ = std::make_unique<DelayedControls>(sensor_->device(), params);
 
 	LOG(SimplePipeline, Debug)
@@ -1666,7 +1668,21 @@
 	if (data->converter_) {
 		return data->converter_->configure(inputCfg, outputCfgs);
 	} else {
+		const auto vblank = data->sensor_->controls().find(V4L2_CID_VBLANK);
+		if (vblank != data->sensor_->controls().end()) {
+			/* Restore the native exposure range on same-mode reopen. */
+			ControlList ctrls(data->sensor_->controls());
+			ctrls.set(V4L2_CID_VBLANK, vblank->second.min().get<int32_t>());
+			ret = data->sensor_->setControls(&ctrls);
+			if (ret)
+				return ret;
+			data->sensor_->device()->updateControlInfo();
+		}
+
 		ipa::softisp::IPAConfigInfo configInfo;
+		ret = data->sensor_->sensorInfo(&configInfo.sensorInfo);
+		if (ret)
+			return ret;
 		configInfo.sensorControls = data->sensor_->controls();
 		return data->swIsp_->configure(inputCfg, outputCfgs, configInfo, &data->controlInfo_);
 	}
diff --git a/test/ipa/libipa/agc_frame_duration.cpp b/test/ipa/libipa/agc_frame_duration.cpp
new file mode 100644
--- /dev/null
+++ b/test/ipa/libipa/agc_frame_duration.cpp
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "agc.h"
+
+#include <array>
+#include <chrono>
+#include <iostream>
+#include <optional>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+
+#include "test.h"
+
+using namespace libcamera;
+using namespace std::chrono_literals;
+
+class AgcFrameDurationTest : public Test
+{
+protected:
+	int run() override
+	{
+		ipa::AgcAlgorithm algorithm;
+		ipa::agc::Session session{};
+		session.lineDuration = 2760 * 1.0s / 200000000;
+		session.sensor.outputSize = { 1936, 1096 };
+		session.sensor.minFrameLength = 1166;
+		session.sensor.maxFrameLength = 65535;
+
+		struct Case {
+			utils::Duration requested;
+			uint32_t expectedFrameLength;
+			int64_t expectedDuration;
+		};
+		const std::array<Case, 3> cases{ {
+			/* Metadata truncation must not produce VBLANK below its minimum. */
+			{ 16090us, 1166, 16090 },
+			/* Round up to avoid exceeding the requested frame rate. */
+			{ 33333us, 2416, 33340 },
+			{ 10s, 65535, 904383 },
+		} };
+
+		for (const Case &test : cases) {
+			ipa::agc::ActiveState state{};
+			ipa::agc::FrameContext frame{};
+			frame.minFrameDuration = test.requested;
+			ControlList metadata(controls::controls);
+			algorithm.process(session, state, frame, std::nullopt, metadata);
+
+			if (frame.vblank + session.sensor.outputSize.height !=
+			    test.expectedFrameLength) {
+				std::cerr << "Unexpected frame length for "
+					  << test.requested << std::endl;
+				return TestFail;
+			}
+
+			const auto duration = metadata.get(controls::FrameDuration);
+			if (!duration || *duration != test.expectedDuration) {
+				std::cerr << "Frame duration metadata differs from sensor timing"
+					  << std::endl;
+				return TestFail;
+			}
+		}
+
+		session.sensor.exposureMargin = 8;
+		session.minExposureTime = session.lineDuration;
+		session.maxExposureTime =
+			(session.sensor.maxFrameLength - session.sensor.exposureMargin) *
+			session.lineDuration;
+
+		for (utils::Duration maximum : { utils::Duration(900ms), utils::Duration(33333us) }) {
+			ipa::agc::ActiveState state{};
+			state.automatic.exposure = 60000;
+			state.automatic.gain = 2.0;
+			ipa::agc::FrameContext frame{};
+			frame.autoExposureEnabled = true;
+			frame.autoGainEnabled = true;
+			frame.exposure = state.automatic.exposure;
+			frame.minFrameDuration = 33333us;
+			frame.maxFrameDuration = maximum;
+			ControlList metadata(controls::controls);
+
+			algorithm.process(session, state, frame, std::nullopt, metadata);
+			algorithm.prepareSensorControls(session, state, frame);
+
+			const uint32_t frameLength =
+				session.sensor.outputSize.height + frame.vblank;
+			if (frame.exposure + session.sensor.exposureMargin > frameLength ||
+			    frame.frameDuration < frame.minFrameDuration ||
+			    frame.frameDuration > maximum + session.lineDuration) {
+				std::cerr << "Skipped statistics produced inconsistent sensor timing"
+					  << std::endl;
+				return TestFail;
+			}
+
+			if ((maximum == utils::Duration(900ms) &&
+			     frame.exposure != state.automatic.exposure) ||
+			    (maximum == utils::Duration(33333us) &&
+			     frame.exposure >= state.automatic.exposure)) {
+				std::cerr << "Exposure was not retained or bounded for the current FPS range"
+					  << std::endl;
+				return TestFail;
+			}
+		}
+
+		return TestPass;
+	}
+};
+
+TEST_REGISTER(AgcFrameDurationTest)
