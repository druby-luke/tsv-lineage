 	context_.sensorControls = configInfo.sensorControls;
 
 	/* Clear the IPA context before the streaming session. */
@@ -251,9 +252,21 @@
 	ControlList metadata(controls::controls);
 	for (const auto &algo : algorithms())
 		algo->process(context_, frame, frameContext, stats_, metadata);
+	const utils::Duration exposureTime =
+		frameContext.sensor.exposure * context_.configuration.agc.lineDuration;
+	metadata.set(controls::ExposureTime, exposureTime.get<std::micro>());
+	metadata.set(controls::AnalogueGain, frameContext.sensor.gain);
+	if (sensorControls.contains(V4L2_CID_VBLANK)) {
+		const uint32_t frameLength = context_.sensorInfo.outputSize.height +
