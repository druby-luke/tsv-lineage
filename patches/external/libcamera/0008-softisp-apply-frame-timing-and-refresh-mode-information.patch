+	session.sensor.minFrameLength = frameHeights[0];
+	session.sensor.maxFrameLength = frameHeights[1];
+	session.sensor.exposureMargin =
+		std::max<int64_t>(0, static_cast<int64_t>(frameHeights[0]) - maxExposure);
+	maxExposure = frameHeights[1] - session.sensor.exposureMargin;
 
 	std::array<int64_t, 3> frameDurations;
 	for (unsigned int i = 0; i < frameHeights.size(); ++i) {
@@ -414,7 +419,6 @@
 	 * to know the limits for exposure time and analogue gain. As it depends
 	 * on the sensor, update it with the controls.
 	 *
-	 * \todo take VBLANK into account for maximum exposure time
 	 */
 	session.minExposureTime = minExposure * session.lineDuration;
 	session.maxExposureTime = maxExposure * session.lineDuration;
@@ -697,6 +701,34 @@
 }
 
 /**
+ * \brief Finalize a matching exposure, gain and frame duration for the sensor
+ * \param[in] session The session configuration
+ * \param[in,out] state The current active state
+ * \param[in,out] frameContext The frame context receiving the sensor controls
+ *
+ * Use the latest exposure state, including when statistics were skipped, and
+ * bound exposure by the requested frame-duration limit before deriving VBLANK.
+ */
+void AgcAlgorithm::prepareSensorControls(const agc::Session &session,
+					agc::ActiveState &state,
+					agc::FrameContext &frameContext)
+{
+	prepare(state, frameContext);
+
+	const utils::Duration margin = session.sensor.exposureMargin * session.lineDuration;
+	const utils::Duration maxExposureTime = std::clamp<utils::Duration>(
+		frameContext.maxFrameDuration - margin,
+		session.minExposureTime, session.maxExposureTime);
+	const uint32_t maxExposure = maxExposureTime / session.lineDuration;
+	frameContext.exposure = std::min(frameContext.exposure, maxExposure);
+
+	processFrameDuration(session, frameContext,
+			     std::max<utils::Duration>(
+				     frameContext.minFrameDuration,
+				     frameContext.exposure * session.lineDuration + margin));
+}
+
+/**
  * \brief Process frame statistics
  * \param[in] session The agc session configuration
  * \param[in] state The agc active state
@@ -746,9 +778,10 @@
 
 	if (frameContext.autoExposureEnabled) {
 		minExposureTime = session.minExposureTime;
-		maxExposureTime = std::clamp(frameContext.maxFrameDuration,
-					     session.minExposureTime,
-					     session.maxExposureTime);
+		maxExposureTime = std::clamp<utils::Duration>(
+			frameContext.maxFrameDuration -
+				session.sensor.exposureMargin * lineDuration,
+			session.minExposureTime, session.maxExposureTime);
 	} else {
 		minExposureTime = lineDuration * frameContext.exposure;
 		maxExposureTime = minExposureTime;
@@ -833,7 +866,9 @@
 	 * the minimum frame duration when we have short exposures.
 	 */
 	processFrameDuration(session, frameContext,
-			     std::max(frameContext.minFrameDuration, newExposureTime));
+			     std::max<utils::Duration>(
+				     frameContext.minFrameDuration,
+				     newExposureTime + session.sensor.exposureMargin * lineDuration));
 
 	fillMetadata(session, frameContext, metadata);
 }
@@ -852,8 +887,10 @@
 {
 	const utils::Duration &lineDuration = session.lineDuration;
 
-	frameContext.vblank =
-		(frameDuration / lineDuration) - session.sensor.outputSize.height;
+	const uint32_t frameLength = std::clamp<uint32_t>(
+		std::ceil(frameDuration / lineDuration),
+		session.sensor.minFrameLength, session.sensor.maxFrameLength);
+	frameContext.vblank = frameLength - session.sensor.outputSize.height;
 
 	/* Update frame duration accounting for line length quantization. */
 	frameContext.frameDuration =
