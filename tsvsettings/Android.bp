// ThinkSmart settings: button actions page, injected into Settings > System.
android_app {
    name: "ThinkSmartSettings",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    // No OTA server exists for this unofficial build; the updater only does failed checks.
    overrides: ["Updater"],
    static_libs: [
        "androidx.preference_preference",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibSettingsTheme",
    ],
}
